{
  "manifest_version": 3,
  "name": "To NIS",
  "version": "1.0.0",
  "description": "Convert foreign currency prices on any page to Israeli New Shekel.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "To NIS"
  }
}
